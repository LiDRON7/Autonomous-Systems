<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_depth">
    <include merge="true">
      <uri>x500</uri>
    </include>
    <include merge="true">
      <uri>model://OakD-Lite</uri>
      <pose>.12 .03 .242 0 0 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>OakD-Lite/base_link</child>
      <pose relative_to="base_link">.12 .03 .242 0 0 0</pose>
    </joint>
    <link name="landing_lidar_link">
      <pose relative_to="base_link">0 0 -0.12 0 0 0</pose>
      <sensor name="landing_lidar" type="gpu_lidar">
        <topic>/lidar/points</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.141593</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-1.570796</min_angle>
              <max_angle>-1.221730</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>30.0</max>
            <resolution>0.02</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <joint name="LandingLidarJoint" type="fixed">
      <parent>base_link</parent>
      <child>landing_lidar_link</child>
    </joint>
  </model>
</sdf>
