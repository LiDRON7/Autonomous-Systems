   "versionNonce": 1291362260,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793972378339,
   "link": null,
   "locked": false,
   "text": "thick outline = state machine, the only part that commands PX4   \u00b7   dashed arrow = wireless   \u00b7   Widow has no LiDAR: require_lidar is false, so it lands at the goal without a landing check\nthe SiK radio is on Pixhawk TELEM1, so QGroundControl and the RTK corrections reach PX4 even if the Pi is down   \u00b7   the laptop reaches the Pi over the Pi's own Wi-Fi hotspot (SSH, ROS 2, camera video on UDP 5600)",
   "originalText": "thick outline = state machine, the only part that commands PX4   \u00b7   dashed arrow = wireless   \u00b7   Widow has no LiDAR: require_lidar is false, so it lands at the goal without a landing check\nthe SiK radio is on Pixhawk TELEM1, so QGroundControl and the RTK corrections reach PX4 even if the Pi is down   \u00b7   the laptop reaches the Pi over the Pi's own Wi-Fi hotspot (SSH, ROS 2, camera video on UDP 5600)",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
